	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:13,000"
			},
			"offsets": {
				"from": 0,
				"to": 13000
			},
			"text": "週末の間さ、あれ、なんか街とか行けたの?"
		},
		{
			"timestamps": {
				"from": "00:00:13,000",
				"to": "00:00:19,000"
			},
			"offsets": {
				"from": 13000,
				"to": 19000
			},
			"text": "そうなんだよ。なんか、メモはきっと信用されてたらしくて、全然自由にされた。"
		},
		{
			"timestamps": {
				"from": "00:00:19,000",
				"to": "00:00:25,000"
			},
			"offsets": {
				"from": 19000,
				"to": 25000
			},
			"text": "なんかね、一番最初の寄宿舎に入るときに、"
		},
		{
			"timestamps": {
				"from": "00:00:25,000",
				"to": "00:00:35,000"
			},
			"offsets": {
				"from": 25000,
				"to": 35000
			},
			"text": "週末、どのような日曜とか、お泊りでもなんでも、行ってもいい人の一応、リストをね、"
		},
		{
			"timestamps": {
				"from": "00:00:35,000",
				"to": "00:00:40,000"
			},
			"offsets": {
				"from": 35000,
				"to": 40000
			},
			"text": "ママたちがサインした、リストがあって、それを学校に見せるのね。"
		},
		{
			"timestamps": {
				"from": "00:00:40,000",
				"to": "00:00:47,000"
			},
			"offsets": {
				"from": 40000,
				"to": 47000
			},
			"text": "それで、出るたんびにどこに行きますか、名前書いて、その方にサインしてもらわなきゃいけないのよ。"
		},
		{
			"timestamps": {
				"from": "00:00:47,000",
				"to": "00:00:51,000"
			},
			"offsets": {
				"from": 47000,
				"to": 51000
			},
			"text": "それで、おじいちゃんも、子供の頃からのお友達がいらっしゃってね。"
		},
		{
			"timestamps": {
				"from": "00:00:51,000",
				"to": "00:00:56,000"
			},
			"offsets": {
				"from": 51000,
				"to": 56000
			},
			"text": "その人も、いつに行くような風に書いたのね、紙には。"
		},
		{
			"timestamps": {
				"from": "00:00:56,000",
				"to": "00:01:00,000"
			},
			"offsets": {
				"from": 56000,
				"to": 60000
			},
			"text": "まあまあ、全面書いたんだけど、おじいちゃんも、私に書いたんだけど。"
		},
		{
			"timestamps": {
				"from": "00:01:00,000",
				"to": "00:01:06,000"
			},
			"offsets": {
				"from": 60000,
				"to": 66000
			},
			"text": "それで、それで、そこの人、実際によく、あのー、日曜日のお昼ご飯に呼んでいただいて。"
		},
		{
			"timestamps": {
				"from": "00:01:06,000",
				"to": "00:01:11,000"
			},
			"offsets": {
				"from": 66000,
				"to": 71000
			},
			"text": "ねえけど、ご飯すんだら、もう、そっちのお子さんまで、全然ちっちゃくてね。"
		},
		{
			"timestamps": {
				"from": "00:01:11,000",
				"to": "00:01:27,000"
			},
			"offsets": {
				"from": 71000,
				"to": 87000
			},
			"text": "もう、ご飯すんだ、すぐに、2時とか2時半にはもう、帰っちゃって、それで、学校の夕方は、ほんと6時までに帰ればいいのね。"
		},
		{
			"timestamps": {
				"from": "00:01:27,000",
				"to": "00:01:34,000"
			},
			"offsets": {
				"from": 87000,
				"to": 94000
			},
			"text": "で、なんか、めめめめも、バカだから、そのまま、すぐ帰ってたわけが、そこに。"
		},
		{
			"timestamps": {
				"from": "00:01:34,000",
				"to": "00:01:36,000"
			},
			"offsets": {
				"from": 94000,
				"to": 96000
			},
			"text": "えええええええ。"
		},
		{
			"timestamps": {
				"from": "00:01:36,000",
				"to": "00:01:40,000"
			},
			"offsets": {
				"from": 96000,
				"to": 100000
			},
			"text": "帰っちゃって、ほんと、あのー、勉強の、あのー、なんだろう。"
		},
		{
			"timestamps": {
				"from": "00:01:40,000",
				"to": "00:01:44,000"
			},
			"offsets": {
				"from": 100000,
				"to": 104000
			},
			"text": "なんだろう、フリースタディーの時間なのね。"
		},
		{
			"timestamps": {
				"from": "00:01:44,000",
				"to": "00:01:45,000"
			},
			"offsets": {
				"from": 104000,
				"to": 105000
			},
			"text": "うんうんうん。"
		},
		{
			"timestamps": {
				"from": "00:01:45,000",
				"to": "00:01:48,000"
			},
			"offsets": {
				"from": 105000,
				"to": 108000
			},
			"text": "日曜日の、日本の、あの、そっきまでは。"
		},
		{
			"timestamps": {
				"from": "00:01:48,000",
				"to": "00:01:50,000"
			},
			"offsets": {
				"from": 108000,
				"to": 110000
			},
			"text": "え、どうやって帰ってたの?バス?"
		},
		{
			"timestamps": {
				"from": "00:01:50,000",
				"to": "00:01:51,000"
			},
			"offsets": {
				"from": 110000,
				"to": 111000
			},
			"text": "か、車?"
		},
		{
			"timestamps": {
				"from": "00:01:51,000",
				"to": "00:01:53,000"
			},
			"offsets": {
				"from": 111000,
				"to": 113000
			},
			"text": "車だよね、たぶん、え、帰って。"
		},
		{
			"timestamps": {
				"from": "00:01:53,000",
				"to": "00:01:55,000"
			},
			"offsets": {
				"from": 113000,
				"to": 115000
