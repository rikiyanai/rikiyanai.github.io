		{
			"timestamps": {
				"from": "00:01:56,000",
				"to": "00:01:58,000"
			},
			"offsets": {
				"from": 116000,
				"to": 118000
			},
			"text": "バス乗って帰ったり、半分歩いたり。"
		},
		{
			"timestamps": {
				"from": "00:01:58,000",
				"to": "00:01:59,000"
