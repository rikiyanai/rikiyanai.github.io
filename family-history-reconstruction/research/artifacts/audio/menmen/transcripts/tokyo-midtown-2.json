		{
			"timestamps": {
				"from": "00:02:13,000",
				"to": "00:02:17,000"
			},
			"offsets": {
				"from": 133000,
				"to": 137000
			},
			"text": "何しても、なんか、疑われるようなことなくてね。"
		},
