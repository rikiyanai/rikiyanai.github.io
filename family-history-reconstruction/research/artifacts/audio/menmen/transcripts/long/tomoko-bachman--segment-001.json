				"to": "00:00:43,000"
			},
			"offsets": {
				"from": 40000,
				"to": 43000
			},
			"text": "ヤツコさんが元に行ったんですか?"
		},
		{
			"timestamps": {
				"from": "00:00:43,000",
				"to": "00:00:47,000"
			},
			"offsets": {
				"from": 43000,
				"to": 47000
			},
