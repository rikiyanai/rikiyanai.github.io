		{
			"timestamps": {
				"from": "00:00:28,000",
				"to": "00:00:32,000"
			},
			"offsets": {
				"from": 28000,
				"to": 32000
			},
			"text": "ミキちゃんは何年もかけてないね。"
		},
		{
			"timestamps": {
				"from": "00:00:32,000",
				"to": "00:00:34,000"
