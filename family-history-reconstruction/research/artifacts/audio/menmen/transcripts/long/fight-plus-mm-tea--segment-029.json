	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:04,000"
			},
			"offsets": {
				"from": 0,
				"to": 4000
			},
			"text": "ちょっと病気になってしまった。"
		},
		{
			"timestamps": {
				"from": "00:00:04,000",
				"to": "00:00:09,000"
			},
			"offsets": {
				"from": 4000,
				"to": 9000
			},
			"text": "コンビスじゃない、違うので変なものが流行った。"
		},
		{
			"timestamps": {
				"from": "00:00:09,000",
				"to": "00:00:12,000"
			},
			"offsets": {
				"from": 9000,
				"to": 12000
			},
			"text": "割と最近だよ。去年ぐらい?"
		},
		{
			"timestamps": {
				"from": "00:00:12,000",
				"to": "00:00:14,000"
			},
			"offsets": {
				"from": 12000,
				"to": 14000
			},
			"text": "去年?"
		},
		{
			"timestamps": {
				"from": "00:00:14,000",
				"to": "00:00:18,000"
			},
			"offsets": {
				"from": 14000,
				"to": 18000
			},
			"text": "それにエミスすごく元気でね。"
		},
		{
			"timestamps": {
				"from": "00:00:18,000",
				"to": "00:00:22,000"
			},
			"offsets": {
				"from": 18000,
				"to": 22000
			},
			"text": "全然病気もしないし、疲れたりもしないのね。"
		},
		{
			"timestamps": {
				"from": "00:00:22,000",
				"to": "00:00:25,000"
			},
			"offsets": {
				"from": 22000,
				"to": 25000
			},
			"text": "だけど、その病気になっちゃって。"
		},
		{
			"timestamps": {
				"from": "00:00:25,000",
				"to": "00:00:30,000"
			},
			"offsets": {
				"from": 25000,
				"to": 30000
			},
			"text": "同じお仕事もらえなくなって。"
		},
		{
			"timestamps": {
				"from": "00:00:30,000",
				"to": "00:00:34,000"
			},
			"offsets": {
				"from": 30000,
				"to": 34000
			},
			"text": "だけど、まだ落ちたんだよ。"
		},
		{
			"timestamps": {
				"from": "00:00:34,000",
				"to": "00:00:37,000"
			},
			"offsets": {
				"from": 34000,
				"to": 37000
			},
			"text": "去年何が流行ったかな。"
		},
		{
			"timestamps": {
				"from": "00:00:37,000",
				"to": "00:00:43,000"
			},
			"offsets": {
				"from": 37000,
				"to": 43000
			},
			"text": "今もレタスに入ったバクテリアが流行ったけど。"
		},
		{
			"timestamps": {
				"from": "00:00:43,000",
				"to": "00:00:48,000"
			},
			"offsets": {
				"from": 43000,
				"to": 48000
			},
			"text": "夏だから、バクテリア病気になりやすい。"
		},
		{
			"timestamps": {
				"from": "00:00:48,000",
				"to": "00:00:52,000"
			},
			"offsets": {
				"from": 48000,
				"to": 52000
			},
			"text": "アメリカの中だったよ。"
		},
		{
			"timestamps": {
				"from": "00:00:52,000",
				"to": "00:00:57,000"
			},
			"offsets": {
				"from": 52000,
				"to": 57000
			},
			"text": "日本も大丈夫だけど、他のアジアの国だと、"
		},
		{
			"timestamps": {
				"from": "00:00:57,000",
				"to": "00:01:00,000"
			},
			"offsets": {
				"from": 57000,
				"to": 60000
			},
			"text": "あんまり流行ったら行けないっていう。"
		},
		{
			"timestamps": {
				"from": "00:01:00,000",
				"to": "00:01:02,000"
			},
			"offsets": {
				"from": 60000,
				"to": 62000
			},
			"text": "うん、南米も同じ。"
		},
		{
			"timestamps": {
				"from": "00:01:02,000",
				"to": "00:01:03,000"
			},
			"offsets": {
				"from": 62000,
				"to": 63000
			},
			"text": "そう?"
		},
		{
			"timestamps": {
				"from": "00:01:03,000",
				"to": "00:01:13,000"
			},
			"offsets": {
				"from": 63000,
				"to": 73000
			},
			"text": "え、なんだろう。大丈夫かな?"
		},
		{
			"timestamps": {
				"from": "00:01:13,000",
				"to": "00:01:16,000"
			},
			"offsets": {
				"from": 73000,
				"to": 76000
			},
			"text": "え、もう大丈夫?でも、今。"
		},
		{
			"timestamps": {
				"from": "00:01:16,000",
				"to": "00:01:18,000"
			},
			"offsets": {
				"from": 76000,
				"to": 78000
			},
			"text": "え、みちちゃん。"
		},
		{
			"timestamps": {
				"from": "00:01:18,000",
				"to": "00:01:20,000"
			},
			"offsets": {
				"from": 78000,
				"to": 80000
			},
			"text": "今、大丈夫?"
		},
		{
			"timestamps": {
				"from": "00:01:20,000",
				"to": "00:01:25,000"
			},
			"offsets": {
				"from": 80000,
				"to": 85000
			},
			"text": "でも、すごく元気だったんだけど、そうでもなくなったらしい。"
		},
		{
			"timestamps": {
				"from": "00:01:25,000",
				"to": "00:01:27,000"
			},
			"offsets": {
				"from": 85000,
				"to": 87000
			},
			"text": "あ、そっか。"
		},
		{
			"timestamps": {
				"from": "00:01:27,000",
				"to": "00:01:31,000"
			},
			"offsets": {
				"from": 87000,
				"to": 91000
			},
			"text": "でも、小さじきは大変だったのよ。"
		},
		{
			"timestamps": {
				"from": "00:01:31,000",
				"to": "00:01:34,000"
			},
			"offsets": {
				"from": 91000,
				"to": 94000
			},
			"text": "もう、ママがいなかったら泣いちゃうのね。"
		},
		{
			"timestamps": {
				"from": "00:01:34,000",
				"to": "00:01:36,000"
			},
			"offsets": {
				"from": 94000,
				"to": 96000
			},
			"text": "あ、そう。"
		},
		{
			"timestamps": {
				"from": "00:01:36,000",
				"to": "00:01:41,000"
			},
			"offsets": {
				"from": 96000,
				"to": 101000
			},
			"text": "ハワイに一度一緒に来たんだけど、何名が入っても全然ダメでね。"
		},
		{
			"timestamps": {
				"from": "00:01:41,000",
				"to": "00:01:42,000"
			},
			"offsets": {
				"from": 101000,
				"to": 102000
			},
			"text": "え?"
		},
		{
			"timestamps": {
				"from": "00:01:42,000",
				"to": "00:01:46,000"
			},
			"offsets": {
				"from": 102000,
				"to": 106000
			},
			"text": "ママが、くにくにぽんがちょっと、ちょっとなんか買いに出ちゃって。"
		},
		{
			"timestamps": {
				"from": "00:01:46,000",
				"to": "00:01:47,000"
			},
			"offsets": {
				"from": 106000,
				"to": 107000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:01:47,000",
				"to": "00:01:56,000"
			},
			"offsets": {
				"from": 107000,
				"to": 116000
			},
			"text": "そしたら、みちちゃんのドアのところで、ちょっと、そのまいといて、それに、そうと抱っこして、それで、なんか、絵本か、なんか見て。"
		},
		{
			"timestamps": {
				"from": "00:01:56,000",
				"to": "00:01:58,000"
			},
			"offsets": {
				"from": 116000,
				"to": 118000
			},
			"text": "えぇ。"
		},
		{
			"timestamps": {
				"from": "00:01:58,000",
				"to": "00:02:02,000"
			},
			"offsets": {
				"from": 118000,
				"to": 122000
			},
			"text": "日本語もそんなに、よくとは分からなくてね。"
		},
		{
			"timestamps": {
				"from": "00:02:02,000",
				"to": "00:02:08,000"
			},
			"offsets": {
				"from": 122000,
				"to": 128000
			},
			"text": "え、両方でも、ちょっと、その絵本の話をしたら、少し後で、少しは機嫌を直した。"
		},
		{
			"timestamps": {
				"from": "00:02:08,000",
				"to": "00:02:10,000"
			},
			"offsets": {
				"from": 128000,
				"to": 130000
			},
			"text": "えぇ。"
		},
		{
			"timestamps": {
				"from": "00:02:10,000",
				"to": "00:02:11,000"
			},
			"offsets": {
				"from": 130000,
				"to": 131000
			},
			"text": "えぇ。"
		},
		{
			"timestamps": {
				"from": "00:02:11,000",
				"to": "00:02:14,000"
			},
			"offsets": {
				"from": 131000,
				"to": 134000
			},
			"text": "あ、そうか。"
		},
		{
			"timestamps": {
				"from": "00:02:14,000",
				"to": "00:02:22,000"
			},
			"offsets": {
				"from": 134000,
				"to": 142000
			},
			"text": "でも、りきみたいに、お料理が上手だったら、もしもし、もし、もしだよ。もし、結婚したらね。"
		},
		{
			"timestamps": {
				"from": "00:02:22,000",
				"to": "00:02:27,000"
			},
			"offsets": {
				"from": 142000,
				"to": 147000
			},
			"text": "もう、奥様が困っちゃうよね。だって、お主人の方がお料理がすごい上手だったら、いやいやいや。"
		},
		{
			"timestamps": {
				"from": "00:02:27,000",
				"to": "00:02:30,000"
			},
			"offsets": {
				"from": 147000,
				"to": 150000
			},
			"text": "でも、何作ったってダメじゃない?だから。"
		},
		{
			"timestamps": {
