				"to": "00:00:25,000"
			},
			"offsets": {
				"from": 20000,
				"to": 25000
			},
			"text": "昔、メンメン、飛行機ってアラスカ行っても止まってたんでしょ?"
		},
		{
			"timestamps": {
				"from": "00:00:25,000",
				"to": "00:00:26,000"
			},
			"offsets": {
				"from": 25000,
				"to": 26000
