			"timestamps": {
				"from": "00:00:39,000",
				"to": "00:00:47,000"
			},
			"offsets": {
				"from": 39000,
				"to": 47000
			},
			"text": "綺麗だけど、やっぱり一年中いたら楽そうよね。"
		},
		{
			"timestamps": {
				"from": "00:00:47,000",
				"to": "00:00:53,000"
			},
			"offsets": {
				"from": 47000,
				"to": 53000
			},
			"text": "うん。でも、夏が一番いいらしい。"
		},
		{
			"timestamps": {
				"from": "00:00:53,000",
				"to": "00:00:56,000"
			},
			"offsets": {
				"from": 53000,
				"to": 56000
			},
			"text": "全然熱くならないから。"
		},
		{
			"timestamps": {
				"from": "00:00:56,000",
				"to": "00:00:59,000"
			},
			"offsets": {
				"from": 56000,
				"to": 59000
			},
			"text": "ちょっとしらない。"
