			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:00:26,000",
				"to": "00:00:33,000"
			},
			"offsets": {
				"from": 26000,
				"to": 33000
			},
			"text": "空港だけ?それとも、一泊ぐらい止まってた?"
		},
		{
			"timestamps": {
				"from": "00:00:33,000",
				"to": "00:00:35,000"
			},
			"offsets": {
				"from": 33000,
				"to": 35000
			},
			"text": "見たことない、アラスカは。"
		},
		{
			"timestamps": {
				"from": "00:00:35,000",
				"to": "00:00:39,000"
			},
			"offsets": {
				"from": 35000,
				"to": 39000
			},
			"text": "でも、アラスカはちょっと降りたりしてみたけどね。"
		},
