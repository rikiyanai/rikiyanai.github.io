			},
			"offsets": {
				"from": 7000,
				"to": 21000
			},
			"text": "でも一回私も会ったのね、そのたかこさんっていう方。"
		},
		{
			"timestamps": {
				"from": "00:00:21,000",
				"to": "00:00:26,000"
			},
			"offsets": {
				"from": 21000,
				"to": 26000
			},
			"text": "それで思ってたよりずっとなんていうか、感じが良かった。"
		},
		{
			"timestamps": {
				"from": "00:00:26,000",
				"to": "00:00:33,000"
			},
			"offsets": {
				"from": 26000,
				"to": 33000
			},
			"text": "もっと怖い人かと思ったら、ちょっと少し見て、会ったら全然違ってびっくりして。"
		},
		{
			"timestamps": {
				"from": "00:00:33,000",
				"to": "00:00:41,000"
			},
			"offsets": {
				"from": 33000,
				"to": 41000
			},
			"text": "そうかと思ってたらやっぱりミキさんがね、一緒にいろいろやってるんだなっていう気がする。"
		},
		{
			"timestamps": {
				"from": "00:00:41,000",
				"to": "00:00:52,000"
			},
			"offsets": {
				"from": 41000,
				"to": 52000
			},
			"text": "お家に来たのよ、みんな。時々やるでしょ、お花だ、お花の時。"
		},
		{
			"timestamps": {
				"from": "00:00:52,000",
				"to": "00:01:21,980"
			},
			"offsets": {
				"from": 52000,
				"to": 81980
			},
			"text": "おめでとうございます。"
		},
		{
			"timestamps": {
				"from": "00:01:22,000",
				"to": "00:01:29,000"
			},
			"offsets": {
				"from": 82000,
				"to": 89000
			},
			"text": "私はね、10本ぐらいで電話。"
		},
		{
			"timestamps": {
				"from": "00:01:29,000",
				"to": "00:01:33,000"
			},
			"offsets": {
				"from": 89000,
				"to": 93000
			},
			"text": "でも、一緒に行って。"
		},
		{
			"timestamps": {
				"from": "00:01:33,000",
				"to": "00:01:36,000"
			},
			"offsets": {
				"from": 93000,
				"to": 96000
			},
			"text": "でも、待っててもいいわよ。"
		},
		{
			"timestamps": {
				"from": "00:01:36,000",
				"to": "00:01:45,000"
			},
			"offsets": {
