				"to": "00:00:16,000"
			},
			"offsets": {
				"from": 11000,
				"to": 16000
			},
			"text": "それで言った、そのお金はどこから来たんですか?なんて聞くの失礼ですよ。"
		},
		{
			"timestamps": {
				"from": "00:00:16,000",
				"to": "00:00:17,000"
			},
			"offsets": {
				"from": 16000,
				"to": 17000
			},
			"text": "えぇ、何それ?"
		},
		{
			"timestamps": {
				"from": "00:00:17,000",
				"to": "00:00:21,000"
			},
			"offsets": {
				"from": 17000,
				"to": 21000
			},
			"text": "ミキサーはびっくりしてて、えぇ、何それ?"
		},
		{
			"timestamps": {
				"from": "00:00:21,000",
				"to": "00:00:33,000"
			},
			"offsets": {
				"from": 21000,
				"to": 33000
			},
			"text": "お金は、違うところから、そこに移したの、あそこだと、プレッシアだったら、アメリカから出せるのね、アメリカに行った時に。"
		},
		{
			"timestamps": {
				"from": "00:00:33,000",
				"to": "00:00:42,000"
			},
			"offsets": {
				"from": 33000,
				"to": 42000
			},
			"text": "だから、アメリカに行ってもお金がいるじゃない、だから、キャッシュで持ってくの大変だから、そっちに移してたのね、一生懸命。"
		},
		{
			"timestamps": {
				"from": "00:00:42,000",
				"to": "00:00:43,000"
			},
			"offsets": {
				"from": 42000,
				"to": 43000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:00:43,000",
				"to": "00:00:49,000"
			},
			"offsets": {
				"from": 43000,
				"to": 49000
			},
			"text": "で、いつかはきっと、そっちの方、余計使うように、アメリカの方が長くなるかなと思って。"
		},
		{
			"timestamps": {
				"from": "00:00:49,000",
				"to": "00:00:50,000"
			},
			"offsets": {
				"from": 49000,
				"to": 50000
			},
			"text": "うんうん。"
		},
		{
			"timestamps": {
				"from": "00:00:50,000",
				"to": "00:00:57,000"
			},
			"offsets": {
				"from": 50000,
				"to": 57000
			},
			"text": "一生懸命映したから、少しいっぱい映したもんだから、そのお金どこから来たんですか?なんて、ひどいじゃない。"
		},
		{
