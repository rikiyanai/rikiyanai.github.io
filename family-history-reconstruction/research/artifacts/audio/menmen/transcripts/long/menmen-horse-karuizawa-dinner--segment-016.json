			"offsets": {
				"from": 0,
				"to": 3400
			},
			"text": "コロンビア人に漢字を聞く"
		},
		{
			"timestamps": {
				"from": "00:00:03,400",
				"to": "00:00:15,180"
			},
			"offsets": {
				"from": 3400,
				"to": 15180
			},
			"text": "だってね今だと大体そういう大きいパリとかロンドンとかそういう大きい街だと必ず日本人学校っていうのがあるんですよ"
		},
		{
			"timestamps": {
				"from": "00:00:15,180",
				"to": "00:00:22,400"
			},
			"offsets": {
				"from": 15180,
				"to": 22400
			},
			"text": "日本人のお子さんたちを1週間に1回でも行かなきゃいけなくて私の孫たちもあれ行けば行かなかったよね"
		},
		{
			"timestamps": {
				"from": "00:00:22,400",
				"to": "00:00:28,960"
			},
			"offsets": {
				"from": 22400,
				"to": 28960
			},
			"text": "だけど大気とか行って行くようにしてたのよね"
		},
		{
			"timestamps": {
				"from": "00:00:28,960",
				"to": "00:00:39,980"
			},
			"offsets": {
				"from": 28960,
				"to": 39980
			},
			"text": "だけど私は最初フランスに行った時はもう日本語なんて全然もう聞こえもしなくてフランス語をやるのを知ってもうきちだったんですよね"
		},
		{
			"timestamps": {
				"from": "00:00:39,980",
				"to": "00:00:44,940"
			},
			"offsets": {
				"from": 39980,
				"to": 44940
			},
			"text": "本当にもうイエスも何も言えなかったから"
		},
		{
			"timestamps": {
				"from": "00:00:44,940",
				"to": "00:00:49,780"
			},
			"offsets": {
				"from": 44940,
				"to": 49780
			},
			"text": "本当に何にもわからなかったから大変でした"
		},
		{
			"timestamps": {
				"from": "00:00:49,780",
				"to": "00:00:53,780"
			},
			"offsets": {
				"from": 49780,
				"to": 53780
			},
			"text": "何歳でフランスに行ったの?"
		},
		{
			"timestamps": {
				"from": "00:00:53,780",
				"to": "00:00:58,400"
			},
			"offsets": {
				"from": 53780,
				"to": 58400
			},
			"text": "小学校終えたところでちょうど12ぐらい"
		},
		{
			"timestamps": {
				"from": "00:00:58,400",
				"to": "00:01:01,660"
			},
			"offsets": {
				"from": 58400,
				"to": 61660
			},
			"text": "12、3になる時だったかな"
		},
		{
			"timestamps": {
				"from": "00:01:01,660",
				"to": "00:01:05,760"
			},
			"offsets": {
				"from": 61660,
				"to": 65760
			},
			"text": "いきなりフランスの学校に入るわけですか?"
		},
		{
			"timestamps": {
				"from": "00:01:05,760",
				"to": "00:01:08,920"
			},
			"offsets": {
				"from": 65760,
				"to": 68920
			},
			"text": "フランス語喋れなくて日本から行って"
		},
		{
			"timestamps": {
				"from": "00:01:08,920",
				"to": "00:01:16,420"
			},
			"offsets": {
				"from": 68920,
				"to": 76420
			},
			"text": "そうそれでもうクラスに入れられちゃって最初はだから全然できないんですよね"
