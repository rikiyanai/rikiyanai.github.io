			},
			"offsets": {
				"from": 79000,
				"to": 90540
			},
			"text": "クロスのボールを飛ばして、1個飛んだらまた次にまたクロスを作ってジャンプ、ジャンプ、ジャンプ、って3回くらいジャンプさせていく。"
		},
		{
			"timestamps": {
				"from": "00:01:30,540",
				"to": "00:01:36,440"
			},
			"offsets": {
				"from": 90540,
				"to": 96440
			},
			"text": "それを繰り返し繰り返し、とにかく教えるんですよね。"
		},
		{
			"timestamps": {
				"from": "00:01:36,440",
				"to": "00:01:45,020"
			},
			"offsets": {
				"from": 96440,
				"to": 105020
			},
			"text": "無理しないで、ひっくりしようからからやっていって、だんだん上げていって。飛んだら褒めて、ニージ上げて。"
		},
		{
			"timestamps": {
				"from": "00:01:45,020",
				"to": "00:02:00,040"
			},
			"offsets": {
				"from": 105020,
				"to": 120040
			},
			"text": "ここはだいたい人情者に座って、やり方全部座って、絶対引っ張られちゃダメだよ。"
		},
		{
			"timestamps": {
				"from": "00:02:00,040",
				"to": "00:02:07,040"
			},
			"offsets": {
				"from": 120040,
				"to": 127040
			},
			"text": "馬が飛んだら褒めて、飛んだら褒めて、それを繰り返すといいのができるから。"
		},
		{
			"timestamps": {
				"from": "00:02:07,040",
				"to": "00:02:09,040"
			},
			"offsets": {
				"from": 127040,
				"to": 129040
			},
			"text": "ゆっくりゆっくり、ちょうど。"
		},
		{
			"timestamps": {
				"from": "00:02:09,040",
				"to": "00:02:15,040"
			},
			"offsets": {
				"from": 129040,
				"to": 135040
			},
			"text": "急にこうやってバーを開けちゃうと、外で人を落ちて嫌なようにしちゃう。"
		},
		{
			"timestamps": {
				"from": "00:02:15,040",
				"to": "00:02:20,060"
			},
			"offsets": {
				"from": 135040,
				"to": 140060
			},
			"text": "飛べるような、ランダムと一回して。"
		},
		{
			"timestamps": {
				"from": "00:02:20,060",
				"to": "00:02:22,060"
			},
			"offsets": {
				"from": 140060,
				"to": 142060
			},
			"text": "そしたら、本当に。"
		},
		{
			"timestamps": {
