	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:07,000"
			},
			"offsets": {
				"from": 0,
				"to": 7000
			},
			"text": "長にメンメンの英語を聞いて、英語で話すように言えば英語ができるように。"
		},
		{
			"timestamps": {
				"from": "00:00:07,000",
				"to": "00:00:15,000"
			},
			"offsets": {
				"from": 7000,
				"to": 15000
			},
			"text": "国とね、そうがあったのよ。国と私と英語で話そうって決めてね、スウェーデンに行った時に。"
		},
		{
			"timestamps": {
				"from": "00:00:15,000",
				"to": "00:00:19,000"
			},
			"offsets": {
				"from": 15000,
				"to": 19000
			},
			"text": "それで、いつも英語で話してる。"
		},
		{
			"timestamps": {
				"from": "00:00:19,000",
				"to": "00:00:25,000"
			},
			"offsets": {
				"from": 19000,
				"to": 25000
			},
			"text": "そうだ、この前どこで習ったって言ったでしょ、英語。"
		},
		{
			"timestamps": {
				"from": "00:00:25,000",
				"to": "00:00:32,000"
			},
			"offsets": {
				"from": 25000,
				"to": 32000
			},
			"text": "私の英語で話すようになった。"
		},
		{
			"timestamps": {
				"from": "00:00:32,000",
				"to": "00:00:35,000"
			},
			"offsets": {
				"from": 32000,
				"to": 35000
			},
			"text": "話せるようになったのは国の関連なんです。"
		},
		{
			"timestamps": {
				"from": "00:00:35,000",
				"to": "00:00:38,000"
			},
			"offsets": {
				"from": 35000,
				"to": 38000
			},
			"text": "英語で話すようになった。"
		},
		{
			"timestamps": {
				"from": "00:00:38,000",
				"to": "00:00:43,000"
			},
			"offsets": {
				"from": 38000,
				"to": 43000
			},
			"text": "英語なのに、英語とかしてる。"
		},
		{
			"timestamps": {
				"from": "00:00:43,000",
				"to": "00:00:45,000"
			},
			"offsets": {
				"from": 43000,
				"to": 45000
			},
			"text": "べきではないけれども、どういう。"
		},
		{
			"timestamps": {
				"from": "00:00:45,000",
				"to": "00:00:50,000"
			},
			"offsets": {
				"from": 45000,
				"to": 50000
			},
			"text": "でも、すごいうまいじゃん。全然普通の英語っていう感じ。"
		},
		{
			"timestamps": {
				"from": "00:00:50,000",
				"to": "00:00:54,000"
			},
			"offsets": {
				"from": 50000,
				"to": 54000
			},
			"text": "ルイシさん一番好きなのはやっぱりスペイン語でしょ。"
		},
		{
			"timestamps": {
				"from": "00:00:54,000",
				"to": "00:00:57,000"
			},
			"offsets": {
				"from": 54000,
				"to": 57000
			},
			"text": "スペイン語でその次は英語。"
		},
		{
			"timestamps": {
				"from": "00:00:57,000",
				"to": "00:00:58,000"
			},
			"offsets": {
				"from": 57000,
				"to": 58000
			},
			"text": "英語。"
		},
		{
			"timestamps": {
				"from": "00:00:58,000",
				"to": "00:01:13,000"
			},
			"offsets": {
				"from": 58000,
				"to": 73000
			},
			"text": "リキー、あなたはアメリカ人の一般的に、集まって、ラティノの集まったら、冗談とか楽しい話があるじゃない。"
		},
		{
			"timestamps": {
				"from": "00:01:13,000",
				"to": "00:01:14,000"
			},
			"offsets": {
				"from": 73000,
				"to": 74000
			},
			"text": "わいわい。"
		},
		{
			"timestamps": {
				"from": "00:01:14,000",
				"to": "00:01:20,000"
			},
			"offsets": {
				"from": 74000,
				"to": 80000
			},
			"text": "でも、アメリカ人は、討論するじゃない。"
		},
		{
			"timestamps": {
				"from": "00:01:20,000",
				"to": "00:01:21,000"
			},
			"offsets": {
				"from": 80000,
				"to": 81000
			},
			"text": "中国では。"
		},
		{
			"timestamps": {
				"from": "00:01:21,000",
				"to": "00:01:22,000"
			},
			"offsets": {
				"from": 81000,
				"to": 82000
			},
			"text": "あ、そういう事でしょ。"
		},
		{
			"timestamps": {
				"from": "00:01:22,000",
				"to": "00:01:24,000"
			},
			"offsets": {
				"from": 82000,
				"to": 84000
			},
			"text": "ちょっと少し証拠を覧めてる。"
		},
		{
			"timestamps": {
				"from": "00:01:24,000",
				"to": "00:01:26,000"
			},
			"offsets": {
				"from": 84000,
				"to": 86000
			},
			"text": "私は中国の…"
		},
		{
			"timestamps": {
				"from": "00:01:26,000",
				"to": "00:01:28,000"
			},
			"offsets": {
				"from": 86000,
				"to": 88000
			},
			"text": "そうね、ヤスコさん、中国の…"
		},
		{
			"timestamps": {
				"from": "00:01:28,000",
				"to": "00:01:29,000"
			},
			"offsets": {
				"from": 88000,
				"to": 89000
			},
			"text": "そっか、わかんない。"
		},
		{
			"timestamps": {
				"from": "00:01:29,000",
				"to": "00:01:31,000"
			},
			"offsets": {
				"from": 89000,
				"to": 91000
			},
			"text": "ヤスコさん、同じだと思って。"
		},
		{
			"timestamps": {
				"from": "00:01:31,000",
				"to": "00:01:33,000"
			},
			"offsets": {
				"from": 91000,
				"to": 93000
			},
			"text": "いらっしゃらなくなっちゃったから、やめちゃったのよ。"
		},
		{
			"timestamps": {
				"from": "00:01:33,000",
				"to": "00:01:34,000"
			},
			"offsets": {
				"from": 93000,
				"to": 94000
			},
			"text": "そうなんですよ。"
		},
		{
			"timestamps": {
				"from": "00:01:34,000",
				"to": "00:01:36,000"
			},
			"offsets": {
				"from": 94000,
				"to": 96000
			},
			"text": "アメリカは好きってこと。"
		},
		{
			"timestamps": {
				"from": "00:01:36,000",
				"to": "00:01:37,000"
			},
			"offsets": {
				"from": 96000,
				"to": 97000
			},
			"text": "そうなんですよ。"
		},
		{
			"timestamps": {
				"from": "00:01:37,000",
				"to": "00:01:38,000"
			},
			"offsets": {
				"from": 97000,
				"to": 98000
			},
			"text": "アメリカは。"
		},
		{
			"timestamps": {
				"from": "00:01:38,000",
				"to": "00:01:39,000"
			},
			"offsets": {
				"from": 98000,
				"to": 99000
			},
			"text": "リベート?"
		},
		{
			"timestamps": {
				"from": "00:01:39,000",
				"to": "00:01:41,000"
			},
			"offsets": {
				"from": 99000,
				"to": 101000
			},
			"text": "リベートみたいな。"
		},
		{
			"timestamps": {
				"from": "00:01:41,000",
				"to": "00:01:44,000"
			},
			"offsets": {
				"from": 101000,
				"to": 104000
			},
			"text": "日本はあんまりやらないから。"
		},
		{
			"timestamps": {
				"from": "00:01:44,000",
				"to": "00:01:48,000"
			},
			"offsets": {
				"from": 104000,
				"to": 108000
			},
			"text": "でも、そもそもこのリベートだ。"
		},
		{
			"timestamps": {
				"from": "00:01:48,000",
				"to": "00:01:55,000"
			},
			"offsets": {
				"from": 108000,
				"to": 115000
			},
			"text": "私、アメリカ人ではないから、でも見ると、大喧嘩ですけどもね。"
		},
		{
			"timestamps": {
				"from": "00:01:55,000",
				"to": "00:02:00,000"
			},
			"offsets": {
				"from": 115000,
				"to": 120000
			},
			"text": "実際にこのディスカッション、リベートだ。"
		},
		{
			"timestamps": {
				"from": "00:02:00,000",
				"to": "00:02:10,000"
			},
			"offsets": {
				"from": 120000,
				"to": 130000
			},
			"text": "年齢とグループによって違うかな。"
		},
		{
			"timestamps": {
				"from": "00:02:15,000",
				"to": "00:02:17,000"
			},
			"offsets": {
				"from": 135000,
				"to": 137000
			},
			"text": "アメリカ人も持ってきますね。"
		},
		{
			"timestamps": {
				"from": "00:02:17,000",
				"to": "00:02:21,000"
			},
			"offsets": {
				"from": 137000,
				"to": 141000
			},
			"text": "最近もね、それ頼んだら、最近断られた。"
		},
		{
			"timestamps": {
				"from": "00:02:21,000",
				"to": "00:02:22,000"
			},
			"offsets": {
				"from": 141000,
				"to": 142000
			},
			"text": "え?なんで?"
		},
		{
			"timestamps": {
				"from": "00:02:22,000",
				"to": "00:02:28,000"
			},
			"offsets": {
				"from": 142000,
				"to": 148000
			},
			"text": "なんかね、人によって、この人は英語の人とか、この人とはフランス語とかって。"
		},
		{
			"timestamps": {
				"from": "00:02:28,000",
				"to": "00:02:36,000"
			},
			"offsets": {
				"from": 148000,
				"to": 156000
			},
			"text": "人はね、人と語学は一緒になってて、めめはいつも日本語だったから、今も英語なんてダメだって。"
		},
		{
			"timestamps": {
				"from": "00:02:36,000",
				"to": "00:02:48,000"
			},
			"offsets": {
				"from": 156000,
				"to": 168000
			},
			"text": "だけど、急に私はなんか英語で言うと、気が付くんないのよ。"
		},
		{
			"timestamps": {
				"from": "00:02:48,000",
				"to": "00:02:50,000"
			},
			"offsets": {
				"from": 168000,
				"to": 170000
			},
			"text": "え?そう?"
		},
		{
			"timestamps": {
				"from": "00:02:50,000",
				"to": "00:02:53,000"
			},
			"offsets": {
				"from": 170000,
				"to": 173000
			},
			"text": "全然英語でパッて答えてくる。"
		},
		{
			"timestamps": {
				"from": "00:02:53,000",
				"to": "00:02:56,000"
			},
			"offsets": {
				"from": 173000,
				"to": 176000
			},
			"text": "ああ、そうだよね。今。"
		},
		{
			"timestamps": {
				"from": "00:02:56,000",
				"to": "00:03:00,000"
			},
			"offsets": {
				"from": 176000,
				"to": 180000
			},
			"text": "行きましょう。"
		}
	]
}
