			"timestamps": {
				"from": "00:02:51,000",
				"to": "00:02:59,000"
			},
			"offsets": {
				"from": 171000,
				"to": 179000
			},
			"text": "大きくなってますよね。だから、このくらいの水槽に勝ってと、それで入らなくなるって、楽しみにしてたんだよね。"
		},
		{
			"timestamps": {
				"from": "00:02:59,000",
				"to": "00:02:59,960"
