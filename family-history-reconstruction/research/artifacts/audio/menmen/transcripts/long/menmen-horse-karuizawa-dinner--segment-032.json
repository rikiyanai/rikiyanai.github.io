			},
			"text": "ナマズって、カイツだったのよね。"
		},
		{
			"timestamps": {
				"from": "00:02:30,000",
				"to": "00:02:34,000"
			},
			"offsets": {
				"from": 150000,
				"to": 154000
			},
			"text": "うん、いや、最初ナマズだってわかってなかった。"
		},
		{
			"timestamps": {
				"from": "00:02:34,000",
				"to": "00:02:36,000"
			},
			"offsets": {
				"from": 154000,
				"to": 156000
