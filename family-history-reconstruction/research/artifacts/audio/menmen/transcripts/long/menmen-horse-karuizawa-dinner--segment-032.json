		},
		{
			"timestamps": {
				"from": "00:02:36,000",
				"to": "00:02:37,000"
			},
			"offsets": {
				"from": 156000,
				"to": 157000
			},
			"text": "あ、そうなんだろう。"
		},
		{
			"timestamps": {
				"from": "00:02:37,000",
				"to": "00:02:38,000"
			},
			"offsets": {
				"from": 157000,
				"to": 158000
			},
			"text": "何だと思ったの?"
		},
		{
			"timestamps": {
