				"to": "00:02:43,000"
			},
			"offsets": {
				"from": 158000,
				"to": 163000
			},
			"text": "なんか、サメ、サメみたいな、小さいサメでかっこいいなと思った。"
		},
		{
			"timestamps": {
				"from": "00:02:43,000",
				"to": "00:02:44,000"
			},
			"offsets": {
				"from": 163000,
