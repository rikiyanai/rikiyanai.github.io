	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:13,000"
			},
			"offsets": {
				"from": 0,
				"to": 13000
			},
			"text": "私の知ってる人が、なんていう名前だっけ、変な名前なんだよ、それを。だからこの人って何人だろうと思ってね。"
		},
		{
			"timestamps": {
				"from": "00:00:13,000",
				"to": "00:00:23,000"
			},
			"offsets": {
				"from": 13000,
				"to": 23000
			},
			"text": "あんまり日本人じゃないって思わないわけ、普通話してれば、ちょっと黒いして、ちょっと見ようと。"
		},
		{
			"timestamps": {
				"from": "00:00:23,000",
				"to": "00:00:31,000"
			},
			"offsets": {
				"from": 23000,
				"to": 31000
			},
			"text": "あれ? 目とかも本当に日本人のタイプ。 インドネシアってモーズドームいっぱいいるんだよね。"
		},
		{
			"timestamps": {
				"from": "00:00:31,000",
				"to": "00:00:35,000"
			},
			"offsets": {
				"from": 31000,
				"to": 35000
			},
			"text": "インドネシアってお前ね。インドネシアに俺も行ったからね。"
		},
		{
			"timestamps": {
				"from": "00:00:35,000",
				"to": "00:00:46,000"
			},
			"offsets": {
				"from": 35000,
				"to": 46000
			},
			"text": "インドネシアでいっぱい、なんだっけ、モーズドーム入って、頭のカバーみたいなのあるじゃん。"
		},
		{
			"timestamps": {
				"from": "00:00:46,000",
				"to": "00:00:52,000"
			},
			"offsets": {
				"from": 46000,
				"to": 52000
			},
			"text": "マービーの? そうそうそうそう。それいっぱい。"
		},
		{
			"timestamps": {
				"from": "00:00:52,000",
				"to": "00:01:06,000"
			},
			"offsets": {
				"from": 52000,
				"to": 66000
			},
			"text": "それであの、なんか、別にね、そんなラブレターを書いたもんないんだけど、"
		},
		{
			"timestamps": {
				"from": "00:01:06,000",
				"to": "00:01:12,000"
			},
			"offsets": {
				"from": 66000,
				"to": 72000
			},
			"text": "でも、なんか、書いちゃった。今度、いつ行くから、ありますね。"
		},
		{
			"timestamps": {
				"from": "00:01:12,000",
				"to": "00:01:16,000"
			},
			"offsets": {
				"from": 72000,
				"to": 76000
			},
			"text": "だって、お店だから、それ。スーパーマーケットだから。"
		},
		{
			"timestamps": {
				"from": "00:01:16,000",
				"to": "00:01:19,000"
			},
			"offsets": {
				"from": 76000,
				"to": 79000
			},
			"text": "うんうん。 いつ来るかわかんないって言ってた。"
		},
		{
			"timestamps": {
				"from": "00:01:19,000",
				"to": "00:01:26,000"
			},
			"offsets": {
				"from": 79000,
				"to": 86000
			},
			"text": "初め、自動車のね、あの、駐車場のテレビみたいなのやってたの。"
		},
		{
			"timestamps": {
				"from": "00:01:26,000",
				"to": "00:01:30,000"
			},
			"offsets": {
				"from": 86000,
				"to": 90000
			},
			"text": "その人、2人だったかな。 西野。"
		},
		{
			"timestamps": {
				"from": "00:01:30,000",
				"to": "00:01:34,000"
			},
			"offsets": {
				"from": 90000,
				"to": 94000
			},
			"text": "西野。 普通に、あの、あそこ。"
		},
		{
			"timestamps": {
				"from": "00:01:34,000",
				"to": "00:01:38,000"
			},
			"offsets": {
				"from": 94000,
				"to": 98000
			},
			"text": "ナショナルとか、自分でいられるんだけど、"
		},
		{
			"timestamps": {
				"from": "00:01:38,000",
				"to": "00:01:42,000"
			},
			"offsets": {
				"from": 98000,
				"to": 102000
			},
			"text": "メディアとかね、そういうところはちょっとうるさいことがあるんだけど、"
		},
		{
			"timestamps": {
				"from": "00:01:42,000",
				"to": "00:01:48,000"
			},
			"offsets": {
				"from": 102000,
				"to": 108000
			},
			"text": "いくら買わないと、タダじゃないとか、いろいろなんで、全然認識もちょっとあるんだけど、"
		},
		{
			"timestamps": {
				"from": "00:01:48,000",
				"to": "00:01:54,000"
			},
			"offsets": {
				"from": 108000,
				"to": 114000
			},
			"text": "結構うるさくて、なんか、自分で、自動車を持ってきてくれたり、いろいろするのよ。"
		},
		{
			"timestamps": {
				"from": "00:01:54,000",
				"to": "00:01:55,000"
			},
			"offsets": {
				"from": 114000,
				"to": 115000
			},
			"text": "ああ。"
		},
		{
			"timestamps": {
				"from": "00:01:55,000",
				"to": "00:01:59,000"
			},
			"offsets": {
				"from": 115000,
				"to": 119000
			},
			"text": "そういうのやってる人、お母さんとか、何人とか一緒にやってて、"
		},
		{
			"timestamps": {
				"from": "00:01:59,000",
				"to": "00:02:07,000"
			},
			"offsets": {
				"from": 119000,
				"to": 127000
			},
			"text": "それが、あの、あの、あの、あの、あの、あの、あの、お母さんとかね、もう、大騒ぎだったんだよ、って言うからね。"
		},
		{
			"timestamps": {
				"from": "00:02:07,000",
				"to": "00:02:08,000"
			},
			"offsets": {
				"from": 127000,
				"to": 128000
			},
			"text": "えぇーって。"
		},
		{
			"timestamps": {
				"from": "00:02:08,000",
				"to": "00:02:11,000"
			},
			"offsets": {
				"from": 128000,
				"to": 131000
			},
			"text": "もう、どうするっていうか。"
		},
		{
			"timestamps": {
				"from": "00:02:11,000",
				"to": "00:02:19,940"
			},
			"offsets": {
				"from": 131000,
				"to": 139940
			},
			"text": "こんなおばあちゃんだからいいじゃない人だから、おばあちゃんなんだから本当に、祈りそれ。"
		},
		{
			"timestamps": {
				"from": "00:02:19,940",
				"to": "00:02:33,980"
			},
			"offsets": {
				"from": 139940,
				"to": 153980
			},
			"text": "若い人だったら期待やと思うんですけど、それで来かいから行かなくなって、だから今のことを「ここ、おっぱいルシアに行こう」とか言ってたんだよね。"
		},
		{
			"timestamps": {
				"from": "00:02:33,980",
				"to": "00:02:40,480"
			},
			"offsets": {
				"from": 153980,
				"to": 160480
			},
			"text": "「あ、そうか」。それで「メイメイ、ニシア好きでしょ?」って言ってくれて。好きだったけど。"
		},
		{
			"timestamps": {
				"from": "00:02:40,480",
				"to": "00:02:50,880"
			},
			"offsets": {
				"from": 160480,
				"to": 170880
			},
			"text": "でも、いろんな面白いものを売っててね。日本のものも売ってるし、いろんな世界でのものを売ってて。"
		},
		{
			"timestamps": {
				"from": "00:02:50,880",
				"to": "00:02:56,000"
			},
			"offsets": {
				"from": 170880,
				"to": 176000
			},
			"text": "なんかナショナラゾンみたいだよね。"
		},
		{
			"timestamps": {
				"from": "00:02:56,000",
				"to": "00:02:59,960"
			},
			"offsets": {
				"from": 176000,
				"to": 179960
			},
			"text": "もっとなんか広くていろいろ。"
		}
	]
}
