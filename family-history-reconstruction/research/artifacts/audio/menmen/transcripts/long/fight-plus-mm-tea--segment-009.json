			},
			"text": "どこで?"
		},
		{
			"timestamps": {
				"from": "00:00:04,000",
				"to": "00:00:10,000"
			},
			"offsets": {
				"from": 4000,
				"to": 10000
			},
			"text": "あの、あの、もう、もう、もう、もう、ルーシーって本当に行っちゃうの?"
		},
		{
			"timestamps": {
				"from": "00:00:10,000",
				"to": "00:00:20,000"
			},
			"offsets": {
				"from": 10000,
				"to": 20000
			},
			"text": "えっと、明日ね。もし明日、群馬に行くなら、えっと、今日ちょっとこういう仕事をしないと。"
		},
		{
			"timestamps": {
				"from": "00:00:20,000",
				"to": "00:00:22,000"
			},
			"offsets": {
				"from": 20000,
				"to": 22000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:00:22,000",
				"to": "00:00:27,000"
			},
			"offsets": {
				"from": 22000,
				"to": 27000
			},
			"text": "大変、明日ね。難しい。"
		},
		{
			"timestamps": {
				"from": "00:00:27,000",
				"to": "00:00:34,000"
			},
			"offsets": {
				"from": 27000,
				"to": 34000
			},
			"text": "うん。そしたら、この辺でいいよね。どこに行こうか。いろんなとこちょっと見て。"
		},
		{
			"timestamps": {
				"from": "00:00:34,000",
				"to": "00:00:35,000"
			},
			"offsets": {
				"from": 34000,
				"to": 35000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:00:35,000",
				"to": "00:00:40,000"
			},
			"offsets": {
				"from": 35000,
				"to": 40000
			},
			"text": "ここでいいか、それで帰り帰りはどうするんだっけ?"
		},
		{
			"timestamps": {
				"from": "00:00:40,000",
				"to": "00:00:43,000"
			},
			"offsets": {
				"from": 40000,
				"to": 43000
			},
			"text": "帰りは、私は、ここに行くの。"
		},
		{
			"timestamps": {
				"from": "00:00:43,000",
				"to": "00:00:48,000"
			},
			"offsets": {
				"from": 43000,
				"to": 48000
			},
			"text": "えっと、4時半くらいでいい?ここ。"
		},
		{
			"timestamps": {
				"from": "00:00:48,000",
				"to": "00:00:50,000"
			},
			"offsets": {
				"from": 48000,
				"to": 50000
			},
			"text": "ここ。"
		},
		{
			"timestamps": {
				"from": "00:00:50,000",
				"to": "00:00:51,000"
			},
			"offsets": {
				"from": 50000,
