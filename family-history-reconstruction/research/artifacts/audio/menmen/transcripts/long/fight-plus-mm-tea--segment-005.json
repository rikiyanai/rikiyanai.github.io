			"timestamps": {
				"from": "00:02:11,000",
				"to": "00:02:12,000"
			},
			"offsets": {
				"from": 131000,
				"to": 132000
			},
			"text": "えっと"
		},
		{
			"timestamps": {
				"from": "00:02:12,000",
				"to": "00:02:13,000"
			},
			"offsets": {
				"from": 132000,
				"to": 133000
			},
			"text": "群馬県"
