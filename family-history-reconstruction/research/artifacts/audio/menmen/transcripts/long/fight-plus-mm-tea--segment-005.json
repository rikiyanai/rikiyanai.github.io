				"from": "00:02:24,040",
				"to": "00:02:27,000"
			},
			"offsets": {
				"from": 144040,
				"to": 147000
			},
			"text": "えっと、美術館、パラ美術館。"
		},
		{
			"timestamps": {
				"from": "00:02:27,000",
				"to": "00:02:31,880"
			},
			"offsets": {
				"from": 147000,
				"to": 151880
			},
			"text": "あっ、あ、私、夢とくんでも忘れちゃったじゃない? 今日出しといたのに…"
