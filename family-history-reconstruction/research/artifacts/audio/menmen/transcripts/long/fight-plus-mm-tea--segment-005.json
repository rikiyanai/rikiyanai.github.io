		{
			"timestamps": {
				"from": "00:02:19,000",
				"to": "00:02:24,040"
			},
			"offsets": {
				"from": 139000,
				"to": 144040
			},
			"text": "じゃあ、メンメン…えっと…何だったっけ?"
