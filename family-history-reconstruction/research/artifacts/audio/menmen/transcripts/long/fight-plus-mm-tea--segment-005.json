			"timestamps": {
				"from": "00:02:32,880",
				"to": "00:02:35,880"
			},
			"offsets": {
				"from": 152880,
				"to": 155880
			},
			"text": "あ、そうい…あぁ、ダメだなよ。"
		},
		{
			"timestamps": {
				"from": "00:02:35,880",
				"to": "00:02:40,880"
			},
			"offsets": {
				"from": 155880,
				"to": 160880
			},
			"text": "今日、もう、きゃすごく慌ててたのよ。 急にウィキさん、おりから言ってきて。"
		},
		{
			"timestamps": {
				"from": "00:02:40,880",
				"to": "00:02:41,920"
			},
			"offsets": {
				"from": 160880,
				"to": 161920
			},
			"text": "あ、そうか、そうか。"
		},
		{
			"timestamps": {
				"from": "00:02:41,920",
				"to": "00:02:45,500"
			},
			"offsets": {
				"from": 161920,
				"to": 165500
			},
			"text": "もう、あの、ウィキにも何か書かなきゃ、 悪いなと思って。"
		},
		{
			"timestamps": {
				"from": "00:02:45,500",
				"to": "00:02:47,700"
			},
			"offsets": {
				"from": 165500,
				"to": 167700
			},
			"text": "またちょっと書いたの、行った?"
		},
		{
			"timestamps": {
				"from": "00:02:47,700",
				"to": "00:02:51,700"
			},
			"offsets": {
				"from": 167700,
				"to": 171700
			},
			"text": "ああ、うん、ごめん、見てない。 もう、ちょっと、ちょっと…"
		},
		{
			"timestamps": {
				"from": "00:02:51,700",
				"to": "00:02:55,700"
			},
			"offsets": {
				"from": 171700,
				"to": 175700
			},
			"text": "えっと…"
		},
		{
			"timestamps": {
				"from": "00:02:55,700",
				"to": "00:03:00,040"
			},
			"offsets": {
				"from": 175700,
				"to": 180040
			},
			"text": "あ、そうか、80秒ですかね。 結局の生活から…"
