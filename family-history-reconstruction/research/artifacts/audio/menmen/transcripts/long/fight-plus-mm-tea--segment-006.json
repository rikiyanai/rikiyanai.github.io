			},
			"offsets": {
				"from": 8000,
				"to": 10000
			},
			"text": "あれ見ればいいから"
		},
		{
			"timestamps": {
				"from": "00:00:10,000",
				"to": "00:00:12,000"
			},
			"offsets": {
				"from": 10000,
				"to": 12000
			},
			"text": "多分インターネットで何か書いてある"
		},
		{
			"timestamps": {
				"from": "00:00:12,000",
				"to": "00:00:22,000"
			},
			"offsets": {
				"from": 12000,
				"to": 22000
			},
			"text": "え、熊県にあるの"
		},
		{
			"timestamps": {
				"from": "00:00:26,000",
				"to": "00:00:30,000"
			},
			"offsets": {
				"from": 26000,
				"to": 30000
			},
			"text": "だからね、昨日カルリザまで行ったばかりじゃない"
		},
		{
			"timestamps": {
				"from": "00:00:30,000",
				"to": "00:00:32,000"
			},
			"offsets": {
				"from": 30000,
				"to": 32000
			},
			"text": "だからちょっと遠すぎると思って"
		},
		{
			"timestamps": {
				"from": "00:00:32,000",
				"to": "00:00:34,000"
			},
			"offsets": {
				"from": 32000,
				"to": 34000
			},
			"text": "カルリザまで行かないで"
		},
		{
			"timestamps": {
				"from": "00:00:34,000",
				"to": "00:00:36,000"
			},
			"offsets": {
				"from": 34000,
				"to": 36000
			},
			"text": "左に行かないで"
		},
		{
			"timestamps": {
				"from": "00:00:36,000",
				"to": "00:00:36,000"
			},
			"offsets": {
				"from": 36000,
				"to": 36000
			},
			"text": "右に行くの"
		},
		{
			"timestamps": {
				"from": "00:00:36,000",
				"to": "00:00:38,000"
			},
			"offsets": {
				"from": 36000,
				"to": 38000
			},
			"text": "2つになってるところで"
		},
		{
			"timestamps": {
				"from": "00:00:38,000",
				"to": "00:00:42,000"
			},
			"offsets": {
				"from": 38000,
				"to": 42000
			},
			"text": "あ、そっかそっか"
		},
		{
			"timestamps": {
