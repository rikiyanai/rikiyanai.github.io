		{
			"timestamps": {
				"from": "00:00:12,000",
				"to": "00:00:17,000"
			},
			"offsets": {
				"from": 12000,
				"to": 17000
			},
			"text": "ああ。"
		},
		{
			"timestamps": {
				"from": "00:00:17,000",
				"to": "00:00:20,000"
			},
			"offsets": {
				"from": 17000,
				"to": 20000
			},
			"text": "そうね、なんか、"
		},
		{
			"timestamps": {
				"from": "00:00:20,000",
				"to": "00:00:29,000"
			},
			"offsets": {
				"from": 20000,
				"to": 29000
			},
			"text": "あれはもう、時間でなんか、みんな、みんな座って、お祈りとか言って、みんなこうやってたんこうになって、あの、やる、やって、それで、"
		},
		{
			"timestamps": {
				"from": "00:00:30,000",
				"to": "00:00:32,000"
			},
			"offsets": {
				"from": 30000,
				"to": 32000
			},
			"text": "ね、はい、そう。"
		},
		{
			"timestamps": {
				"from": "00:00:32,000",
				"to": "00:00:34,000"
			},
			"offsets": {
				"from": 32000,
				"to": 34000
			},
			"text": "何してる、ミスラムとか言うの?"
		},
		{
			"timestamps": {
				"from": "00:00:34,000",
				"to": "00:00:35,000"
			},
			"offsets": {
				"from": 34000,
				"to": 35000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:00:35,000",
				"to": "00:00:38,000"
			},
			"offsets": {
				"from": 35000,
				"to": 38000
			},
			"text": "それって、あの、何人が多いと思う?"
		},
		{
			"timestamps": {
				"from": "00:00:38,000",
				"to": "00:00:41,000"
			},
			"offsets": {
				"from": 38000,
				"to": 41000
			},
			"text": "どういう人がそういう人なんだ?"
		},
		{
			"timestamps": {
				"from": "00:00:41,000",
				"to": "00:00:42,000"
			},
			"offsets": {
				"from": 41000,
				"to": 42000
			},
			"text": "え、わかんない。"
		},
		{
			"timestamps": {
				"from": "00:00:42,000",
				"to": "00:00:50,000"
			},
			"offsets": {
				"from": 42000,
				"to": 50000
			},
			"text": "だけど、あの、みんなとこはもう、日本人と同じでね、顔が、それで、あの、日本語もペラペラなのよ。"
		},
		{
			"timestamps": {
				"from": "00:00:50,000",
				"to": "00:00:52,000"
			},
			"offsets": {
				"from": 50000,
				"to": 52000
			},
			"text": "え、インドネシア?"
		},
		{
			"timestamps": {
				"from": "00:00:52,000",
				"to": "00:00:56,000"
			},
			"offsets": {
				"from": 52000,
				"to": 56000
			},
			"text": "そういう人、あの、ミスラムっていうスーパーがあってね、"
		},
		{
			"timestamps": {
				"from": "00:00:56,000",
				"to": "00:01:00,000"
			},
			"offsets": {
				"from": 56000,
				"to": 60000
			},
			"text": "そういう人と、すごい可愛い男の子でね。"
		},
		{
			"timestamps": {
				"from": "00:01:00,000",
				"to": "00:01:01,000"
			},
			"offsets": {
				"from": 60000,
				"to": 61000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:01:01,000",
				"to": "00:01:03,000"
			},
			"offsets": {
				"from": 61000,
				"to": 63000
			},
			"text": "そういう人とね、何故か話すようになっちゃって。"
		},
		{
			"timestamps": {
				"from": "00:01:03,000",
				"to": "00:01:04,000"
			},
			"offsets": {
				"from": 63000,
				"to": 64000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:01:04,000",
				"to": "00:01:11,000"
			},
			"offsets": {
				"from": 64000,
				"to": 71000
			},
			"text": "そしたら、あの、それで、ある時、あの、今日は彼らいないんですかって、私、それ聞いちゃったんだ。"
		},
		{
			"timestamps": {
				"from": "00:01:11,000",
				"to": "00:01:13,000"
			},
			"offsets": {
				"from": 71000,
				"to": 73000
			},
			"text": "そしたら、誰かが呼んでたんだ。"
		},
		{
			"timestamps": {
				"from": "00:01:13,000",
				"to": "00:01:21,000"
			},
			"offsets": {
				"from": 73000,
				"to": 81000
			},
			"text": "よく行ったんだけど、ただ聞いただけだったんだけど、呼んで、降りてきて、それで、そしたら、今、お祈りしてたんですよっていう、"
		},
		{
			"timestamps": {
				"from": "00:01:21,000",
				"to": "00:01:23,000"
			},
			"offsets": {
				"from": 81000,
				"to": 83000
			},
			"text": "ああ、うん。"
		},
		{
			"timestamps": {
				"from": "00:01:23,000",
				"to": "00:01:29,000"
			},
			"offsets": {
				"from": 83000,
				"to": 89000
			},
			"text": "そういう人と、えぇ、って、お祈りって、私も、お祈りの時間があるんだよって言ったのね。"
		},
		{
			"timestamps": {
				"from": "00:01:29,000",
				"to": "00:01:37,000"
			},
			"offsets": {
				"from": 89000,
				"to": 97000
			},
			"text": "それで、あの、クリスチャンなのって言ったら、うん、あの、ね、ブルークラブなんだって言ったの。"
		},
		{
			"timestamps": {
				"from": "00:01:37,000",
				"to": "00:01:38,000"
			},
			"offsets": {
				"from": 97000,
				"to": 98000
			},
			"text": "へぇ。"
		},
		{
			"timestamps": {
				"from": "00:01:38,000",
				"to": "00:01:43,000"
			},
			"offsets": {
				"from": 98000,
				"to": 103000
			},
			"text": "だけど、もう、見たとこ、本当に日本人に、それが、少し、ちょっと黒いかな。"
		},
		{
			"timestamps": {
				"from": "00:01:43,000",
				"to": "00:01:48,000"
			},
			"offsets": {
				"from": 103000,
				"to": 108000
			},
			"text": "まあ、ちょっとだけ黒いんだけど、でも、すごく可愛いんだけど、でも、なんか、"
		},
		{
			"timestamps": {
				"from": "00:01:49,000",
				"to": "00:01:56,000"
			},
			"offsets": {
				"from": 109000,
				"to": 116000
			},
			"text": "そこで、私も色々失敗したから、日々から、松倉に行かない。"
		},
		{
			"timestamps": {
				"from": "00:01:56,000",
				"to": "00:01:57,000"
			},
			"offsets": {
				"from": 116000,
				"to": 117000
			},
			"text": "えぇ。"
		},
		{
			"timestamps": {
				"from": "00:01:57,000",
				"to": "00:02:05,000"
			},
			"offsets": {
				"from": 117000,
				"to": 125000
			},
			"text": "だって、だって、あの、あの、あの、メールアドレスするみたいなの、あの、お電話で、かけられる。"
		},
		{
			"timestamps": {
				"from": "00:02:05,000",
				"to": "00:02:06,000"
			},
			"offsets": {
				"from": 125000,
				"to": 126000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:02:06,000",
				"to": "00:02:15,000"
			},
			"offsets": {
				"from": 126000,
				"to": 135000
			},
			"text": "電話かけて、なんか、ちょっとかけるじゃない。携帯に。そういう、そういう番号だって言ってくれたからね。だから、なんか、色々書いちゃったね。"
		},
		{
			"timestamps": {
				"from": "00:02:15,000",
				"to": "00:02:16,000"
			},
			"offsets": {
				"from": 135000,
				"to": 136000
			},
			"text": "あ、そっか。"
		},
		{
			"timestamps": {
				"from": "00:02:16,000",
				"to": "00:02:19,000"
			},
			"offsets": {
				"from": 136000,
				"to": 139000
			},
			"text": "そういう人は、それ、彼1人の方がなかったの。"
		},
		{
			"timestamps": {
				"from": "00:02:19,000",
				"to": "00:02:20,000"
			},
			"offsets": {
				"from": 139000,
				"to": 140000
			},
			"text": "あははは。"
		},
		{
			"timestamps": {
				"from": "00:02:20,000",
				"to": "00:02:25,000"
			},
			"offsets": {
				"from": 140000,
				"to": 145000
			},
			"text": "そういう、そんな人が見ちゃってね。"
		},
		{
			"timestamps": {
				"from": "00:02:25,000",
				"to": "00:02:26,000"
			},
			"offsets": {
				"from": 145000,
				"to": 146000
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:02:26,000",
				"to": "00:02:37,000"
			},
			"offsets": {
				"from": 146000,
				"to": 157000
			},
			"text": "それなんか、あの、あの、書くのはダメだったんだよって言うわけだったんだけど、そんなことしたって、そうマルーンを流したら、電話なんか、普段できないですね。"
		},
		{
			"timestamps": {
				"from": "00:02:37,000",
				"to": "00:02:44,000"
			},
			"offsets": {
				"from": 157000,
				"to": 164000
			},
			"text": "そういう人がやっているのが、そういう人だからね。あの、あの、実はいなかったかな。"
		},
		{
			"timestamps": {
				"from": "00:02:44,000",
				"to": "00:02:50,000"
			},
			"offsets": {
				"from": 164000,
				"to": 170000
			},
			"text": "実はね、あの、実はね、実はなかったよね。なんか、みんなで日誌に行った時、いっぱいなかったよね。"
		},
		{
			"timestamps": {
				"from": "00:02:50,000",
				"to": "00:02:53,000"
			},
			"offsets": {
				"from": 170000,
				"to": 173000
			},
			"text": "彼がいたのかな。誰か、アムちゃんが、誰かいた。"
		},
		{
			"timestamps": {
				"from": "00:02:53,000",
				"to": "00:02:57,000"
			},
			"offsets": {
				"from": 173000,
				"to": 177000
			},
			"text": "彼が、アムちゃんが、誰かいた。アムちゃんが、何かいた。アムちゃんが、何かにアムちゃんがいたの。すごい綺麗だから、みんなが、アムに行った。"
		},
		{
			"timestamps": {
				"from": "00:02:57,000",
				"to": "00:03:00,040"
			},
			"offsets": {
