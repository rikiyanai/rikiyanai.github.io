				"to": "00:00:42,000"
			},
			"offsets": {
				"from": 38000,
				"to": 42000
			},
			"text": "大人しかったんですよってアブエロが喜んでらっしゃって。"
		},
		{
			"timestamps": {
				"from": "00:00:42,000",
				"to": "00:00:46,000"
			},
			"offsets": {
				"from": 42000,
				"to": 46000
			},
