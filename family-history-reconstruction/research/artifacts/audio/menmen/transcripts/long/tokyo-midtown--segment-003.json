				"to": "00:00:28,000"
			},
			"offsets": {
				"from": 24000,
				"to": 28000
			},
			"text": "それに乗せられて、それをまたベッドの上に乗せて。"
		},
		{
			"timestamps": {
				"from": "00:00:28,000",
				"to": "00:00:37,000"
			},
			"offsets": {
				"from": 28000,
				"to": 37000
			},
			"text": "ママが空港に戻ってくる間、ジュースのままはいたって言ったら、カワイトルになっちゃって。"
		},
		{
			"timestamps": {
				"from": "00:00:37,000",
