				"to": "00:00:58,000"
			},
			"offsets": {
				"from": 54000,
				"to": 58000
			},
			"text": "うん。もう何年もでも10年くらいあってない。"
		},
		{
			"timestamps": {
				"from": "00:00:58,000",
				"to": "00:01:03,000"
			},
			"offsets": {
				"from": 58000,
				"to": 63000
