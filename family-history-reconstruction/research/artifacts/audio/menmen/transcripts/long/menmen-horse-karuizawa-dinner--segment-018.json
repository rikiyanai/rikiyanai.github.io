				"to": "00:00:22,000"
			},
			"offsets": {
				"from": 14000,
				"to": 22000
			},
			"text": "私の娘がね、やっぱりお家では日本語で、そうじゃないと日本語を例えば大学で取りますよね。"
		},
		{
			"timestamps": {
				"from": "00:00:22,000",
				"to": "00:00:27,000"
			},
			"offsets": {
				"from": 22000,
				"to": 27000
			},
			"text": "それでもこういう普通の日本語って習わないから、しゃべれるようにならないから。"
		},
		{
			"timestamps": {
				"from": "00:00:27,000",
				"to": "00:00:31,000"
			},
			"offsets": {
				"from": 27000,
				"to": 31000
			},
			"text": "だからお家では日本語をしゃべる。"
		},
		{
			"timestamps": {
				"from": "00:00:31,000",
				"to": "00:00:38,000"
			},
			"offsets": {
				"from": 31000,
				"to": 38000
			},
			"text": "みんなそう知ってたはずなのね。私の妹が一人いるんだけど、旦那さんがイギリス人なんですね。"
		},
		{
			"timestamps": {
				"from": "00:00:38,000",
				"to": "00:00:47,000"
			},
			"offsets": {
				"from": 38000,
				"to": 47000
			},
			"text": "それでやっぱり女の子がいて、お家では日本語って言ってたんだけど、エミの日本語変ですよね。"
		},
		{
			"timestamps": {
				"from": "00:00:47,000",
				"to": "00:00:52,000"
			},
			"offsets": {
				"from": 47000,
				"to": 52000
			},
			"text": "本当に、あの、すごい。"
		},
		{
			"timestamps": {
				"from": "00:00:52,000",
				"to": "00:00:54,000"
			},
			"offsets": {
				"from": 52000,
				"to": 54000
			},
			"text": "え、言うのも言うの?"
