				"to": "00:00:18,320"
			},
			"offsets": {
				"from": 9240,
				"to": 18320
			},
			"text": "2人で引っ張っていただいてそういう始め方をしたんですね まだあの小学校の頃"
		},
		{
			"timestamps": {
				"from": "00:00:18,320",
				"to": "00:00:20,000"
			},
			"offsets": {
				"from": 18320,
				"to": 20000
			},
			"text": "いうまで"
		},
		{
			"timestamps": {
				"from": "00:00:20,000",
				"to": "00:00:28,000"
			},
			"offsets": {
				"from": 20000,
				"to": 28000
			},
			"text": "いうまあ 長くじゃなくてねあの2つ馬を片っ方に先生がノリになって"
		},
		{
			"timestamps": {
				"from": "00:00:28,000",
				"to": "00:00:35,280"
			},
			"offsets": {
				"from": 28000,
				"to": 35280
			},
			"text": "あの同じくらいの大きさの馬に私が乗ってあの 風なでを"
		},
		{
			"timestamps": {
				"from": "00:00:35,280",
				"to": "00:00:46,960"
			},
			"offsets": {
				"from": 35280,
				"to": 46960
			},
			"text": "のマイドイって始めようでそのうちあのそれを取ってしまったんだけどうまいあの 一緒によるものと思っているんですよね"
		},
		{
			"timestamps": {
				"from": "00:00:56,000",
				"to": "00:00:58,000"
			},
			"offsets": {
				"from": 56000,
				"to": 58000
			},
			"text": "ん"
		},
		{
			"timestamps": {
				"from": "00:00:58,000",
				"to": "00:01:05,280"
			},
			"offsets": {
				"from": 58000,
				"to": 65280
			},
			"text": "何年か前に柳屋さんのお母様とここで食事"
		},
		{
			"timestamps": {
				"from": "00:01:05,280",
				"to": "00:01:07,280"
			},
			"offsets": {
				"from": 65280,
				"to": 67280
			},
			"text": "昔は"
